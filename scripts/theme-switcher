#!/usr/bin/env bash
#
# Theme Switcher
# Switches between themes for kitty, waybar, rofi, tmux, neovim, and wallpaper
#

set -euo pipefail

THEMES_DIR="$HOME/.Themes/themes"
CURRENT_THEME_FILE="$HOME/.Themes/.current-theme"

# Config locations
KITTY_THEME="$HOME/.config/kitty/current-theme.conf"
WAYBAR_STYLE="$HOME/.config/waybar/style.css"
ROFI_COLORS="$HOME/.config/rofi/colors.rasi"
TMUX_THEME="$HOME/.tmux-theme.conf"
NVIM_COLORSCHEME="$HOME/.config/nvim/.colorscheme"

list_themes() {
    echo "Available themes:"
    for theme_dir in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme_dir")
        if [[ -f "$CURRENT_THEME_FILE" ]] && [[ "$(cat "$CURRENT_THEME_FILE")" == "$theme_name" ]]; then
            echo "  * $theme_name (current)"
        else
            echo "    $theme_name"
        fi
    done
}

get_current_theme() {
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        cat "$CURRENT_THEME_FILE"
    else
        echo "none"
    fi
}

apply_theme() {
    local theme_name="$1"
    local theme_path="$THEMES_DIR/$theme_name"

    if [[ ! -d "$theme_path" ]]; then
        echo "Error: Theme '$theme_name' not found in $THEMES_DIR"
        list_themes
        exit 1
    fi

    echo "Applying theme: $theme_name"

    # Kitty - copy color theme and reload
    if [[ -f "$theme_path/kitty-colors.conf" ]]; then
        cp "$theme_path/kitty-colors.conf" "$KITTY_THEME"
        echo "  ✓ Kitty colors updated"
        # Reload kitty by sending SIGUSR1 (it watches included files)
        for pid in $(pgrep -x kitty); do
            kill -SIGUSR1 "$pid" 2>/dev/null || true
        done
        echo "  ✓ Kitty reloaded"
    fi

    # Waybar
    if [[ -f "$theme_path/waybar.css" ]]; then
        cp "$theme_path/waybar.css" "$WAYBAR_STYLE"
        echo "  ✓ Waybar style updated"
        # Reload waybar
        if pgrep -x waybar &>/dev/null; then
            pkill -SIGUSR2 waybar 2>/dev/null || true
            echo "  ✓ Waybar reloaded"
        fi
    fi

    # Rofi
    if [[ -f "$theme_path/rofi.rasi" ]]; then
        cp "$theme_path/rofi.rasi" "$ROFI_COLORS"
        echo "  ✓ Rofi colors updated"
    fi

    # Wallpaper
    local wallpaper=""
    for ext in png jpg jpeg webp; do
        if [[ -f "$theme_path/wallpaper.$ext" ]]; then
            wallpaper="$theme_path/wallpaper.$ext"
            break
        fi
    done

    if [[ -n "$wallpaper" ]]; then

        if command -v swww &>/dev/null; then
            # Check if swww daemon is running
            if ! pgrep -x swww-daemon &>/dev/null; then
                swww-daemon &
                sleep 0.5
            fi
            swww img "$wallpaper" --transition-type wipe --transition-angle 45 --transition-duration 1
            echo "  ✓ Wallpaper set"
        else
            echo "  ! swww not found, skipping wallpaper"
        fi
    fi

    # Tmux
    if [[ -f "$theme_path/tmux.conf" ]]; then
        cp "$theme_path/tmux.conf" "$TMUX_THEME"
        echo "  ✓ Tmux theme updated"
        # Reload just the theme file (not full config, which would re-run TPM)
        if command -v tmux &>/dev/null && tmux list-sessions &>/dev/null; then
            tmux source-file "$TMUX_THEME" 2>/dev/null || true
            echo "  ✓ Tmux reloaded"
        fi
    fi

    # Neovim
    if [[ -f "$theme_path/nvim.txt" ]]; then
        cp "$theme_path/nvim.txt" "$NVIM_COLORSCHEME"
        echo "  ✓ Neovim colorscheme updated"
        # Send command to all running neovim instances via nvr if available
        if command -v nvr &>/dev/null; then
            local colorscheme
            colorscheme=$(cat "$theme_path/nvim.txt")
            # Handle rose-pine variants
            case "$colorscheme" in
                rose-pine-*)
                    nvr --serverlist | xargs -I {} nvr --servername {} -c "lua require('rose-pine').setup({ variant = '${colorscheme#rose-pine-}', styles = { transparency = true } })" 2>/dev/null || true
                    nvr --serverlist | xargs -I {} nvr --servername {} -c "colorscheme rose-pine" 2>/dev/null || true
                    ;;
                *)
                    nvr --serverlist | xargs -I {} nvr --servername {} -c "colorscheme $colorscheme" 2>/dev/null || true
                    ;;
            esac
            echo "  ✓ Neovim instances updated (restart for full effect)"
        else
            echo "  i Restart Neovim to apply colorscheme"
        fi
    fi

    # Save current theme
    echo "$theme_name" > "$CURRENT_THEME_FILE"
    echo ""
    echo "Theme '$theme_name' applied successfully!"
}

show_help() {
    echo "Usage: $(basename "$0") [COMMAND] [THEME]"
    echo ""
    echo "Commands:"
    echo "  apply <theme>   Apply the specified theme"
    echo "  list            List available themes"
    echo "  current         Show current theme"
    echo "  help            Show this help message"
    echo ""
    echo "Examples:"
    echo "  $(basename "$0") apply Original"
    echo "  $(basename "$0") apply CatppuccinLatte"
    echo "  $(basename "$0") list"
}

# Main
case "${1:-help}" in
    apply)
        if [[ -z "${2:-}" ]]; then
            echo "Error: Please specify a theme name"
            list_themes
            exit 1
        fi
        apply_theme "$2"
        ;;
    list)
        list_themes
        ;;
    current)
        echo "Current theme: $(get_current_theme)"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        # If first arg looks like a theme name, apply it directly
        if [[ -d "$THEMES_DIR/$1" ]]; then
            apply_theme "$1"
        else
            echo "Unknown command: $1"
            show_help
            exit 1
        fi
        ;;
esac
